# Copy to .env for local runs; set the same names as Railway variables in production.
ODDS_API_KEY=
OWLS_API_KEY=
# Railway Postgres connection string. Without it, picks are saved to TRACKER_FILE,
# which a Railway redeploy wipes.
DATABASE_URL=
TRACKER_FILE=./data/esports-picks.json
# Required to grade or void picks from the Track Record view.
TRACKER_ADMIN_TOKEN=
# Only picks at or above this EV % are tracked (default 0).
TRACK_MIN_EV=0
MODEL_WEIGHT=0.35
# Match context: ratings refresh automatically; CS2 needs match odds entered
# via POST /api/esports/match-odds (uses TRACKER_ADMIN_TOKEN).
# Alerts: edges at or above this EV % (default 5). ALERT_WEBHOOK_URL is where every alert goes:
#   phone push, free, no account: install the ntfy app, subscribe to a topic name only you know, and set
#     https://ntfy.sh/<that-topic> (tapping a push opens the alert's Kalshi or Polymarket US link)
#   Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<your chat id>
#   Slack incoming webhook, or a Discord webhook URL
# Several, comma-separated, all get every alert. Each deploy posts one "is live" line there
# (ALERT_STARTUP=off stops it).
ALERT_MIN_EV=5
ALERT_WEBHOOK_URL=
# Accounts + billing. Leave PAYWALL off until Stripe is set up: with it off,
# everyone sees everything, exactly as before.
PAYWALL=off
# Signs login tokens. Any long random string; changing it logs everyone out.
AUTH_SECRET=
# Stripe: secret key, the recurring price for Pro, and the webhook signing
# secret for https://<backend>/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Free trial length in days (0 for none).
STRIPE_TRIAL_DAYS=0
# Users file when there's no DATABASE_URL (wiped on redeploy, like the tracker file).
USERS_FILE=./data/users.json
# +EV screener: how vig is removed from sharp prices, "power" (default) or "multiplicative".
EV_DEVIG=power
# Live +EV alerts: new edges at or above this EV % go to the app stream and ALERT_WEBHOOK_URL.
EV_ALERT_MIN=3
# Steam and sharp-lead alerts also go to ALERT_WEBHOOK_URL; set to off to stop them.
SHARP_WEBHOOK=on
# How long the app's shared Odds API responses are cached (ms). Higher saves credits.
ODDS_FEED_TTL_MS=120000
# Exchanges (public market data, no keys). Override the series/tags to watch, and fees.
KALSHI_SERIES=
POLYMARKET_TAGS=
KALSHI_FEE_RATE=0.07
# Polymarket's taker fee comes from each market's own fee schedule (shares × rate × p(1 − p); sports 5%,
# most other markets free). This flat rate only applies to markets that publish no schedule.
POLYMARKET_FEE_RATE=0
# +EV track record: prices flagged at this EV % or better are logged and graded on closing-line value.
TRACK_EV_MIN=2
EV_TRACK_FILE=./data/ev-bets.json
# Esports data from PandaScore (developers.pandascore.co): CS2, CoD and Valorant team ratings,
# best-of for every series, and automatic grading of CS2/Valorant/CoD picks (player stats need a plan that includes them).
PANDASCORE_TOKEN=
# Pinnacle esports moneylines for match context, from Pinnacle's public guest odds API.
# Not a licensed feed: check Pinnacle's terms before using it in a paid product. Leave blank to keep it off.
PINNACLE_GUEST_KEY=
# Low-usage mode for small Odds API plans (the free plan is 500 credits a month). Set to your monthly
# credits to spread them evenly over the month; it also turns on by itself on plans of 1,000 or fewer.
# Set to off to disable. ODDS_API_RESET_DAY is the day of the month your credits reset (default 1).
# Player props are skipped in low-usage mode unless ODDS_API_PROPS=on.
ODDS_API_BUDGET=
ODDS_API_RESET_DAY=1
ODDS_API_PROPS=
# Sharp Tail (🐋 SHARP TAIL tab): Polymarket wallets with a provable edge, graded A (elite) / B (sharp),
# their new bets as signals sized in units (1u = 1% of bankroll), whale flow, exchange arbs. Free public
# APIs, no keys. Every threshold is TAIL_ + the option name in snake case; blank keeps the default.
# Units: ROI / share keys (*_MIN_ROI, *_MIN_RECENT_ROI, *_MAX_CONCENTRATION, TAIL_MAX_TWO_SIDED) are
# percent, and TAIL_CHASE_MAX is cents: any value of 1 or more (or -1 or less) is divided by 100, so
# 8 = 8%, 1 = 1%, -10 = -10%, TAIL_CHASE_MAX=3 = 3¢. A value strictly between -1 and 1 is taken as
# the fraction itself (0.08 = 8%). TAIL_KELLY_FRACTION, TAIL_REGRESSION and TAIL_MAX_PROB are plain
# factors (0.25, 1 = full Kelly); a value above 1 is read as percent (25 = 0.25).
# Where the users are. us (the default): US persons can't trade on Polymarket International, so arbs
# use only Kalshi and US sportsbooks, every signal names the best US venue for the same bet (Kalshi, or
# the team's moneyline at a US sportsbook) or says "watch only", and the app never links to
# polymarket.com. intl: every venue, Polymarket links included.
TAIL_REGION=us
# Closing-line value: how many of a wallet's most recently settled events are checked (the biggest bet in
# each, priced between 3¢ and 97¢) against the price just before the game started, or for a market with no
# game, the price TAIL_CLV_HORIZON_DAYS after the bet (sooner if the outcome got out first). One bet counts
# at most TAIL_CLV_CAP (1 = +100%). Only wallets that already pass the B gates, or could, are checked.
TAIL_CLV_SAMPLE=25
# TAIL_CLV_HORIZON_DAYS=2
# TAIL_CLV_CAP=1
# Data licences. Polymarket's terms give a personal licence and Kalshi's data terms are personal and
# non-commercial, so with PAYWALL on (other people using it) each source is shown to the admin
# (TRACKER_ADMIN_TOKEN) only, and everyone else sees "waiting on data permission", until written
# permission is in and its flag is on. With PAYWALL off (just you) everything shows.
# POLYMARKET_DISPLAY_OK: wallet traders, signals, whale prints and track-record rows (and Polymarket
# prices in intl mode). KALSHI_DISPLAY_OK: Kalshi prices, Kalshi whale prints, Kalshi arb legs, Kalshi
# venues on signals and Kalshi books on the +EV board. Webhook posts follow the same rules.
POLYMARKET_DISPLAY_OK=off
KALSHI_DISPLAY_OK=off
# Trades under this many dollars make no signal.
TAIL_MIN_TRADE=500
# A sale of this % of the position or more is an exit: it ends the tail (pinged when we tailed it); less is a trim.
TAIL_EXIT_SHARE=50
# Polymarket US (gateway.polymarket.us, public, no key): game tails are also quoted on the same market there. off = not quoted.
POLYMARKET_US=on
# Dollars of zero-edge betting mixed into each wallet's edge estimate (bigger = more cautious sizing).
TAIL_PRIOR_RISK=20000
# Grade A checks: resolved bets, distinct events, dollars risked, ROI % (open bets marked at today's
# price), luck z-score (bets on one event count as one), max % of profit from one event or one day's
# markets in a category, a bet within this many days, and the last-30-day ROI floor %.
TAIL_A_MIN_N=100
TAIL_A_MIN_EVENTS=30
TAIL_A_MIN_RISKED=50000
TAIL_A_MIN_ROI=8
TAIL_A_MIN_Z=3
TAIL_A_MAX_CONCENTRATION=35
TAIL_A_ACTIVE_DAYS=30
TAIL_A_MIN_RECENT_ROI=-10
# Grade B: the same checks, looser, with no recent-ROI floor. Raise TAIL_B_MIN_Z (and TAIL_A_MIN_Z) to
# cut lucky wallets: candidates are the top of the PnL leaderboards, picked from a huge pool.
TAIL_B_MIN_N=50
TAIL_B_MIN_EVENTS=15
TAIL_B_MIN_RISKED=20000
TAIL_B_MIN_ROI=4
TAIL_B_MIN_Z=2
TAIL_B_MAX_CONCENTRATION=40
TAIL_B_ACTIVE_DAYS=45
# Wallets holding both sides in more than this % of their markets are market makers, not tailable.
TAIL_MAX_TWO_SIDED=30
# Out of sample: once this many bets have resolved since a wallet was picked, they must be in profit
# or it loses its grade.
TAIL_FORWARD_MIN_N=30
# A category with at least this many bets and no edge of its own isn't tailed on the overall grade.
TAIL_CAT_BAD_MIN_N=20
# Don't chase: no units when the price is more than this many cents above their fill.
TAIL_CHASE_MAX=3
# Sizing: the share of Kelly staked, the unit caps for A and B, and the cap when 2+ graded wallets agree.
TAIL_KELLY_FRACTION=0.25
TAIL_A_CAP_UNITS=2
TAIL_B_CAP_UNITS=1
TAIL_MAX_UNITS=3
# Wallets scored per minute (each costs 3 to 12 requests to Polymarket's data API; closed positions
# come 50 to a page, up to TAIL_CLOSED_MAX_PAGES pages).
TAIL_BATCH_SIZE=3
TAIL_CLOSED_MAX_PAGES=10
# An unknown wallet seen in the trade feed is queued for scoring after one trade this big, or a second
# trade of TAIL_MIN_TRADE+. Memory caps: trade-sourced wallets queued, and scored wallets kept (the
# oldest untailable ones are forgotten first; graded and leaderboard wallets are always kept).
TAIL_TRADE_CANDIDATE_MIN=5000
TAIL_MAX_CANDIDATES=50000
TAIL_MAX_TRADERS=20000
# Tail signals' track record and the scored wallets, when there's no DATABASE_URL (wiped on redeploy).
# With DATABASE_URL they go in the tail_signals and tail_traders tables.
TAIL_TRACK_FILE=./data/tail-signals.json
TAIL_TRADERS_FILE=./data/tail-traders.json
# A-grade and consensus signals, and arbs at or above XARB_ALERT_MIN %, go to ALERT_WEBHOOK_URL; off stops them.
TAIL_WEBHOOK=on
# Whale flow: a single print (Kalshi) or order (Polymarket) this many dollars or bigger.
WHALE_MIN_USD=5000
# Fresh-wallet radar: an ungraded whale buy from a wallet whose first trade was within WHALE_FRESH_DAYS
# and that has traded WHALE_FRESH_MAX_MARKETS markets or fewer is tagged, pinged and logged as 1u in
# its own record (/api/tail/record?book=fresh). WHALE_FRESH_DAYS=0 turns it off. WHALE_FRESH_MIN_USD
# defaults to WHALE_MIN_USD. FRESH_TRACK_FILE: its record without DATABASE_URL (table fresh_signals with).
# WHALE_FRESH_DAYS=7
# WHALE_FRESH_MAX_MARKETS=5
# WHALE_FRESH_MIN_USD=5000
# Exchange arbs (Kalshi, Polymarket, sportsbooks): smallest profit % listed, and smallest that alerts.
# Stakes are shown as each leg's % of the total, the same for everyone. Fees: KALSHI_FEE_RATE and each
# Polymarket market's schedule (see POLYMARKET_FEE_RATE above). "Buy every outcome" arbs whose outcome list isn't
# visibly complete (no "Other" / "Someone else" / open-ended range) are listed but never alerted.
XARB_MIN_PCT=0.5
XARB_ALERT_MIN=1
# Kalshi vs Polymarket US arbs (both US venues): the Polymarket US leagues each scan reads (comma list of
# its league slugs, default nfl,cfb,nba,nhl,mlb,wnba,cbb,wcbb,mls,epl,ucl,uefa,lal,bun,sea,fl1,lol,cs2,valorant,cod;
# off = none), and how many of its order books are read to confirm what clears before it's listed.
# XARB_PMUS_LEAGUES=nfl,nba,nhl,mlb
# XARB_PMUS_BOOKS_PER_SCAN=40
# Kalshi lists its longest-dated events first and the main scan stops after 6,000, so this many more pages
# (200 events each) of the rest are read per scan, cycling through the whole list (0 = off).
# XARB_KALSHI_TAIL_PAGES=6
# Kalshi and Polymarket are free APIs: at most one request per this many ms to each host.
UPSTREAM_GAP_MS=1000
# Esports match board (/api/esports/matches): every esports match on Kalshi and Polymarket, priced
# against each other and a sportsbook (CS2, via bo3.gg). An edge is a venue's ask plus fee at least
# ESPORTS_EDGE_MIN (0.02 = 2%) below the fair price from the other sources; ESPORTS_ALERT_MIN sends it to
# ALERT_WEBHOOK_URL. ESPORTS_MAX_SPREAD: widest bid/ask that still counts as a price.
# ESPORTS_EDGE_MIN=0.02
# ESPORTS_ALERT_MIN=0.04
# ESPORTS_MAX_SPREAD=0.08
# Underdog's lines feed (beta/v5 answers 426 since 2026-10)
# UNDERDOG_URL=https://api.underdogfantasy.com/v1/over_under_lines
