{
  "name": "line-reaper-backend",
  "version": "3.190.0",
  "description": "Line Reaper backend - scrapes DFS books and proxies sharp API calls",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "build_desktop": "pkg . --targets node22-win-x64,node22-macos-x64,node22-macos-arm64 --out-path dist-desktop",
    "e2e": "node e2e/run.js",
    "e2e:serve": "node e2e/harness.js",
    "e2e:record": "node e2e/record.js",
    "live-check": "node e2e/live-check.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": "desktop/launcher.js",
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "scripts": [
      "*.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@yao-pkg/pkg": "^6.23.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.3"
  }
}
