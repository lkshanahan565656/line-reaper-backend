s_usdc__label_account_status_failed\":\"Failed\",\"web_fiat_edd_application_result_polling__label_verifying_details\":\"Verifying your details\",\"web_fiat_repay_outstanding_balance__will_be_frozen\":\"Your account will be frozen if your Outstanding Balance is not repaid within 90 days.\",\"web_fiat_tag__recommended\":\"Popular\",\"web_fiat_transaction_detail__label_account\":\"Account {0}\",\"web_fiat_transaction_detail__label_google_pay\":\"Google Pay\",\"web_fiat_transaction_detail__label_google_pay_debit_only\":\"Google Pay (Debit card only)\",\"web_fiat_transfer_limit_prime__label_unlimited\":\"Unlimited\",\"web_fiat_wallet__footer_faq\":\"To learn more visit our ^[Help Center](link:\\\"{0}\\\")\",\"web_fiat_wallet_address_verification_incomplete__label_pending\":\"Pending\",\"web_fiat_wallet_application_landing__title_ars_address_approved\":\"Success\",\"web_fiat_wallet_bank_account_deletion__button_delete\":\"Delete\",\"web_fiat_wallet_bank_account_deletion__label_are_you_sure\":\"Are you sure you want to remove {0}\",\"web_fiat_wallet_bank_account_deletion__title_delete_bank_account\":\"Delete Bank Account\",\"web_fiat_wallet_bank_account_deletion__title_delete_bank_email\":\"Delete bank account via email\",\"web_fiat_wallet_bank_account_selection__label_action_required\":\"Action required\",\"web_fiat_wallet_bank_account_selection__label_no_paypal_account\":\"No PayPal account available\",\"web_fiat_wallet_bank_account_selection__label_pending\":\"Pending\",\"web_fiat_wallet_bank_account_selection__label_rejected\":\"Rejected\",\"web_fiat_wallet_bank_account_selection__label_relink\":\"Relink\",\"web_fiat_wallet_bank_account_selection__label_remove_paypal_account_confirmation\":\"Are you sure you want to remove this PayPal account?\",\"web_fiat_wallet_bank_account_selection__label_remove_venmo_account_confirmation\":\"Are you sure you want to remove this Venmo account?\",\"web_fiat_wallet_bank_account_selection__label_require_link_paypal_account\":\"Link your PayPal account to your {0} account to make a deposit\",\"web_fiat_wallet_bank_account_selection__label_unavailable\":\"Unavailable\",\"web_fiat_wallet_bank_account_selection__title_delete_paypal_account\":\"Delete PayPal account\",\"web_fiat_wallet_bank_account_selection__title_delete_venmo_account\":\"Delete Venmo account\",\"web_fiat_wallet_enable_two_fa__label_button_cta\":\"Enable 2FA\",\"web_fiat_wallet_setup_pending_screen__label_pending\":\"We are setting things up and will notify you when it's ready. This can take up to a few hours but is usually less.\",\"web_fiat_withdraw_amount_input__label_withdraw_between\":\"You can withdraw {0} to {1} at a time\",\"web_fiat_withdraw_confirm_payment__label_withdraw_to\":\"Withdraw To\",\"web_fiat_withdraw_explainer__label_request_desc\":\"Submit a request to withdraw {0} from your wallet.\",\"web_fiat_withdraw_explainer__label_usd_swift_activate_desc\":\"We support USD withdrawals via the SWIFT method to your external bank account. For bank accounts used for the first time, you are required to make a deposit from it first via the SWIFT method before it's enabled for withdrawal\",\"web_fiat_withdraw_explainer__label_usd_swift_receive_fund_desc\":\"Withdrawal via SWIFT typically arrives in your bank account in 1-5 business days. Your bank may charge additional processing fee to receive SWIFT transactions.\",\"web_fiat_withdraw_explainer__label_usd_swift_request_desc\":\"Submit a request to withdraw {0} via SWIFT from your cash account\",\"web_fiat_withdraw_explainer__label_usd_swift_review_desc\":\"Most withdrawals process within minutes and we will notify you once your request has been approved. In some cases, such as your first withdrawal, a manual review of 1 to 3 business days may be required.\",\"web_fiat_withdraw_explainer__label_usd_us_ach_activate_desc\":\"For bank accounts used for the first time, you are required to link it or make a deposit from it first before it's enabled for withdrawals.\",\"web_fiat_withdraw_explainer__label_usd_us_ach_receive_fund_desc\":\"ACH Bank Transfer: Within 1-5 days.\",\"web_fiat_withdraw_explainer__label_usd_us_ach_request_desc\":\"Submit a request to withdraw USD from your cash account.\",\"web_fiat_withdraw_explainer__label_usd_us_ach_review_desc\":\"Most withdrawals process within minutes and we will notify you once your request has been approved. In some cases, such as your first withdrawal, a manual review of 1 to 3 business days may be required.\",\"web_fiat_withdraw_explainer__label_usd_usd_rtp_activate_desc\":\"For bank accounts used for the first time, you are required to link it or make a deposit from it first before it's enabled for withdrawals.\",\"web_fiat_withdraw_explainer__label_usd_usd_rtp_receive_fund_desc\":\"ACH Bank Transfer: Within 1-5 days.\\n\\nReal-Time Payment: Instantly after submission.\",\"web_fiat_withdraw_explainer__label_usd_usd_rtp_request_desc\":\"Submit a request to withdraw USD from your cash account.\",\"web_fiat_withdraw_explainer__label_usd_usd_rtp_review_desc\":\"Most withdrawals process within minutes and we will notify you once your request has been approved. In some cases, such as your first withdrawal, a manual review of 1 to 3 business days may be required.\",\"web_fiat_withdraw_explainer__label_usd_usd_swift_activate_desc\":\"For bank accounts used for the first time you are required to make a deposit from it first before its enabled for withdrawals.\",\"web_fiat_withdraw_explainer__label_usd_usd_swift_receive_fund_desc\":\"Withdrawal via SWIFT typically arrives in your bank account in 1-5 business days. Your bank may charge additional processing fee to receive SWIFT transactions.\",\"web_fiat_withdraw_explainer__label_usd_usd_swift_review_desc\":\"Most withdrawals process within minutes and we will notify you once your request has been approved. In some cases, such as your first withdrawal, a manual review of 1 to 3 days may be required.\\n\",\"web_fiat_withdrawal_confirmation__button_cancel