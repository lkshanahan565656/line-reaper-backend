e__fee_label\":\"Fee\",\"web_fiat__confirmation_page__fee_usd_value\":\"$${0} {1}\",\"web_fiat__confirmation_page__fund_availability_note_usd_simple_text_content_cdna\":\"It can take up to 2-3 business days for the transaction to be available in the USD Wallet. By tapping Confirm, you are authorizing the above one-time transaction and understand that this transaction cannot be revoked.\",\"web_fiat__confirmation_page__intermediary_bank_fee_simple_text_content\":\"Please note: Intermediary bank fee (if any) and your bank's processing fee to receive SWIFT transactions may be deducted from this amount.\",\"web_fiat__confirmation_page__method_label\":\"Method\",\"web_fiat__confirmation_page__method_us_ach_pull_value\":\"Linked bank account\",\"web_fiat__confirmation_page__processing_time_label\":\"Processing time\",\"web_fiat__confirmation_page__received_amount_label_large\":\"^[Top up amount](color: 'primary', font: 'label_large')\",\"web_fiat__confirmation_page__requested_amount_label\":\"Requested amount\",\"web_fiat__confirmation_page__sufficient_funds_alert_simple_text_content\":\"You must keep sufficient funds in your bank account for at least 7 business days after initiating the deposit, or it will fail.\",\"web_fiat__confirmation_page__sufficient_funds_alert_simple_text_title\":\"Important\",\"web_fiat__confirmation_page__title\":\"Confirm deposit\",\"web_fiat__confirmation_page__us_ach_withdrawal_note_simple_text_content\":\"Please note: Your bank might apply a processing fee. By tapping Confirm, you are authorizing the above one-time transaction and understand that this transaction cannot be revoked.\",\"web_fiat__confirmation_page__withdrawal_amount_label\":\"Amount\",\"web_fiat__confirmation_page__withdrawal_amount_usd_value\":\"$${0} {1}\",\"web_fiat__confirmation_page__withdrawal_fee_label\":\"Fees\",\"web_fiat__confirmation_page__withdrawal_fee_usd_value\":\"$${0} {1}\",\"web_fiat__confirmation_page__withdrawal_method_card_value\":\"Debit card\",\"web_fiat__confirmation_page__withdrawal_method_label\":\"Method\",\"web_fiat__confirmation_page__withdrawal_method_sepa_value\":\"SEPA\",\"web_fiat__confirmation_page__withdrawal_method_us_ach_value\":\"ACH Bank Transfer\",\"web_fiat__confirmation_page__withdrawal_method_usd_rtp_value\":\"Real-Time Payment\",\"web_fiat__confirmation_page__withdrawal_method_usd_swift_value\":\"SWIFT\",\"web_fiat__confirmation_page__withdrawal_receivable_amount_label\":\"^[Received amount](color: 'primary', font: 'label_large')\",\"web_fiat__confirmation_page__withdrawal_receivable_amount_usd_value\":\"^[${0} {1}](color:'primary', font: 'label_large')\",\"web_fiat__confirmation_page__withdrawal_title\":\"Confirm Withdrawal\",\"web_fiat__confirmation_page__withdrawal_to_card_value\":\"{0}\",\"web_fiat__confirmation_page__withdrawal_to_label\":\"Withdraw to\",\"web_fiat__confirmation_page__withdrawal_to_value\":\"{0}\\n^[Account {1}](color:'secondary', font: 'body_small')\",\"web_fiat__description_deposit_bank_info\":\"You must include the Identification Number below in your bank transfer for us to identify your deposit. If you made a deposit but forgot to include it or made a mistake? \u003clink\u003eClick here\u003c/link\u003e\",\"web_fiat__description_paypal_added\":\"You can now top up your {currencyId} Account with this account\",\"web_fiat__description_paypal_pending\":\"We will notify you once your account is added\",\"web_fiat__description_remove_card_confirm\":\"Are you sure you want to remove Card\",\"web_fiat__description_use_debit_card\":\"You can use debit cards to fund your {currencyId} Wallet. If your card is not displayed, you may have added a credit card instead.\",\"web_fiat__description_venmo_added\":\"You can now top up your {currencyId} Account with this account\",\"web_fiat__description_venmo_pending\":\"We will notify you once your account is added\",\"web_fiat__error_cannot_withdraw_to_bank\":\"You cannot withdraw to {status} bank accounts. Deposits take up to {numberOfDays} days to process.\",\"web_fiat__error_check_card_details\":\"Please check the details or add another card.\",\"web_fiat__error_create_withdrawal_failed\":\"Failed to create withdrawal order, please try again later.\",\"web_fiat__error_max_attempts_reached\":\"Reached maximum attempts\",\"web_fiat__error_sending_email_failed\":\"Something went wrong sending email\",\"web_fiat__error_ssn_already_exists\":\"SSN already exists in the system. Please contact our customer service\",\"web_fiat__error_transaction_failed\":\"Your transaction did not go through. Please use a different deposit method or try again.\",\"web_fiat__hint_venmo_pending\":\"We are verifying your account. This typically takes a few minutes to a few hours. We'll notify you once your account is linked.\",\"web_fiat__insufficient_balance__available_description\":\"This limit is based on factors including your bank balance, unsettled transfers, and transaction history.\",\"web_fiat__insufficient_balance__available_title\":\"Available for deposit: {0}\",\"web_fiat__label_account_disabled_description\":\"You can't deposit funds right now. Please contact customer support for assistance.\",\"web_fiat__label_ach_pull_explainer\":\"Set up instant deposits by easily and securely linking your account to OG.com via Plaid.\",\"web_fiat__label_ach_pull_withdrawal_delay\":\"Your funds are available instantly to trade, but you can only withdraw them after 7 business days\",\"web_fiat__label_bank_account_linked_cash_account\":\"Your bank account has been linked to your Cash Account\",\"web_fiat__label_bank_account_linked_wallet\":\"Your bank account has been linked to your wallet\",\"web_fiat__label_bank_account_pending_deposit_removal_blocked\":\"Your bank account cannot be removed because you have a pending deposit via the linked bank account\",\"web_fiat__label_bank_account_pending_transaction_removal_blocked\":\"Your bank account cannot be removed because you have a pending transaction\",\"web_fiat__label_bank_account_pending_withdrawal_removal_blocked\":\"Your bank account cannot be removed because you have a pending withdrawal\",\"web_fiat__label_bank_details_ready\":\"Your new provider bank details are ready.\",\"web_fiat__label_card_withdrawal_disabled\":\"Disabled\",\"web_fiat__label_card_withdrawal_dont_show_again\":\"Don't show this again\",\"web_fiat__label_card_withdrawal_info_body\":\"For regulatory reasons, funds can only be withdrawn to the same card used to top up. Your limit per card equals the total topped up with that card in the last 180 days.\",\"web_fiat__label_card_withdrawal_intro_body\":\"For regulatory reasons, funds can only be withdrawn to the same card used for your previous top-up. Limits vary by card, select a card to see its available amount.\",\"web_fiat__label_card_withdrawal_unavailable_tooltip\":\"There's no card deposit recorded from this card in the last 180 days, thus you can't withdraw from this card.\",\"web_fiat__label_connecting_to_plaid\":\"Connecting to Plaid...\",\"web_fiat__label_fund_with_bank_account\":\"Fund with your bank account seamlessly\",\"web_fiat__label_linking_bank_account\":\"Linking your bank account...\",\"web_fiat__label_linking_unsuccessful_description\":\"Your bank account could not be linked. Please check your details and try again.\",\"web_fiat__label_near_instant_transfers\":\"Transfers at near-instant speed\",\"web_fiat__label_no_deposit_method\":\"No deposit method found\",\"web_fiat__label_no_reference_code\":\"Did not receive your reference number? For more information \u003clinkInformation\u003eclick here\u003c/linkInformation\u003e or contact us via the \u003clinkHelp\u003eHelp Center\u003c/linkHelp\u003e.\",\"web_fiat__label_no_withdrawal_method\":\"No withdrawal method found\",\"web_fiat__label_paypal_linking\":\"Linking your PayPal account...\",\"web_fiat__label_sending_email\":\"Sending email...\",\"web_fiat__label_setup_in_progress_description\":\"You can still deposit but trading is only available after setup is complete.\",\"web_fiat__label_shared_cdc_account_limit\":\"This is shared with your Crypto.com account limit\",\"web_fiat__label_venmo_connecting\":\"Connecting to Venmo...\",\"web_fiat__label_venmo_linking\":\"Linking your Venmo account...\",\"web_fiat__label_verification_pending_description\":\"We will update you soon\",\"web_fiat__label_wallet_ready\":\"Your wallet is now ready to use.\",\"web_fiat__label_wallet_ready_to_trade\":\"You can now use your wallet to trade\",\"web_fiat__label_zero_deposit_fees\":\"Zero deposit fees\",\"web_fiat__switch_account_page_label_add\":\"Add\",\"web_fiat__tag_deposit_method_popular\":\"Popular\",\"web_fiat__title_account_disabled\":\"Account disabled\",\"web_fiat__title_bank_account_linked\":\"Bank account linked\",\"web_fiat__title_card_withdrawal_info\":\"Withdraw to your card\",\"web_fiat__title_enter_passcode\":\"Enter passcode\",\"web_fiat__title_how_to_deposit\":\"How to deposit\",\"web_fiat__title_how_to_withdraw\":\"How to withdraw\",\"web_fiat__title_linking_unsuccessful\":\"Linking unsuccessful\",\"web_fiat__title_paypal_added\":\"PayPal Account Added\",\"web_fiat__title_paypal_pending\":\"PayPal Account Pending\",\"web_fiat__title_set_up_wallet\":\"Set up wallet\",\"web_fiat__title_setup_in_progress\":\"Setup in progress\",\"web_fiat__title_unable_to_remove\":\"Unable to remove\",\"web_fiat__title_venmo_added\":\"Venmo Account Added\",\"web_fiat__title_venmo_pending\":\"Venmo Account Pending\",\"web_fiat__title_verification_pending\":\"Verification pending\",\"web_fiat__toast_bank_account_removed\":\"Bank Account Removed\",\"web_fiat__toast_card_removed\":\"Card Removed\",\"web_fiat__toast_paypal_deposit_completed\":\"Requested\",\"web_fiat__toast_paypal_removed\":\"PayPal Account Removed\",\"web_fiat__toast_venmo_deposit_completed\":\"Requested\",\"web_fiat__toast_venmo_removed\":\"Venmo Account Removed\",\"web_fiat__toast_withdrawal_email_removed\":\"Withdrawal Email Removed\",\"web_fiat_authorize_