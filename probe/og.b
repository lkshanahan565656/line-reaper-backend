pto.com Terms \u0026 Conditions](link:\\\"{0}\\\"), and ^[Privacy Notice](link:\\\"{1}\\\").\",\"deposit_mesh_info__title\":\"Deposit crypto, receive cash\",\"deposit_mesh_info__wallet_creation_pending_description\":\"Wallet generation is taking longer.\\nPlease come back later.\",\"deposit_mesh_info__wallet_creation_pending_title\":\"Wallet setup in progress\",\"deposit_mesh_success_description\":\"Your crypto transfer is being processed\",\"deposit_mesh_success_title\":\"{0} Deposit Initiated\",\"deposit_mesh_success_toast\":\"Your {amount} deposit is in progress and will be credited to your account when it receives network confirmation\",\"deposit_method_unavailable\":\"Unavailable\",\"deposit_paypal_success_description\":\"Your top-up via PayPal is processing\",\"deposit_paypal_success_title\":\"{0} Deposit Requested\",\"deposit_pending__description\":\"We're now processing your {0} deposit. This can take up to 60 seconds.\\n\\nYou can close this page in the meantime.\",\"deposit_pending__title\":\"{0} Deposit Pending\",\"deposit_push__details_subtitle\":\"Enter the account information into your banking app to transfer funds to your OG.com account. To learn more visit our ^[Help Center](link:\\\"{0}\\\").\",\"deposit_push__details_title\":\"Receive {currency} from your bank\",\"deposit_push__important_notes_account_name_description\":\"The name on your bank account must match the name on your OG.com account.\",\"deposit_push__important_notes_account_name_title\":\"Account name\",\"deposit_push__important_notes_currency_description\":\"Select {currency} as the recipient currency to avoid settlement failures. If your account is in a different currency, the bank sets the exchange rate.\",\"deposit_push__important_notes_currency_title\":\"Currency\",\"deposit_push__important_notes_fees_description_no_fee\":\"OG.com won't charge any fees but bank fees may apply.\",\"deposit_push__important_notes_fees_description_usd_swift\":\"Exchange rates are determined by your bank.\",\"deposit_push__important_notes_fees_description_with_fee\":\"OG.com charges a {fee} fee. Bank fees may also apply.\",\"deposit_push__important_notes_fees_title\":\"Fees \u0026 rates\",\"deposit_push__important_notes_processing_time_title\":\"Processing time\",\"deposit_push__important_notes_processing_time_us_ach\":\"Deposits processed within 3-5 business days\",\"deposit_push__important_notes_processing_time_us_wire_transfer\":\"Deposits processed within 1-2 business days.\",\"deposit_push__important_notes_processing_time_usd_swift\":\"Converting EUR or GBP may take 24 hours. Other currencies may take 3–7 days.\",\"deposit_push__important_notes_subtitle\":\"Read this before you proceed.\",\"deposit_push__important_notes_title\":\"Important notes\",\"deposit_push__label_max_per_transfer\":\"Maximum deposit of {max}\",\"deposit_push__label_min_max_per_transfer\":\"Min. {min} \u0026 Max. {max} per transfer.\",\"deposit_push__label_min_per_transfer\":\"Minimum deposit of at least {min}\",\"deposit_push__label_setting_up_description\":\"We are setting things up and will notify you when it's ready. This can take up to a few hours but is usually less.\",\"deposit_push__label_setting_up_title\":\"We're on it\",\"deposit_push__transfer_type_label\":\"Transfer type\",\"deposit_push__transfer_type_note_usd_swift\":\"*Do not use other methods such as SEPA/FPS\",\"deposit_push__transfer_type_value_us_ach\":\"ACH - USD\",\"deposit_push__transfer_type_value_us_wire_transfer\":\"Wire - USD\",\"deposit_push__transfer_type_value_usd_swift\":\"SWIFT - USD\",\"deposit_submitted__label_information_submitted\":\"Information Submitted\",\"deposit_submitted__label_thank_you\":\"Thank you for your submission\",\"deposit_success_description\":\"You can now use your cash to trade\",\"deposit_success_title\":\"{0} Deposit Success\",\"deposit_trading_limit__button_continue\":\"Continue\",\"deposit_trading_limit__button_start_trading\":\"Start trading\",\"deposit_trading_limit__desc_avail