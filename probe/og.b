__label_tradesfurnishing\":\"Trades - Furnishing\",\"cad_fiat_identity_verification_occupation_list_selected__label_tradesimagesocialandotherpersonal\":\"Trades - Image, Social and Other Personal\",\"cad_fiat_identity_verification_occupation_list_selected__label_tradespersonalassistant\":\"Trades - Personal Assistant\",\"cad_fiat_identity_verification_occupation_list_selected__label_tradespersonaltrainer\":\"Trades - Personal Trainer\",\"cad_fiat_identity_verification_occupation_list_selected__label_unemploymentassistance\":\"Unemployment/Assistance\",\"cad_fiat_identity_verification_occupation_list_selected__label_usersupporttechnicians\":\"User support technicians\",\"cad_fiat_identity_verification_occupation_list_selected__label_veterinarian\":\"Veterinarian\",\"cad_fiat_identity_verification_occupation_list_selected__label_volunteer\":\"Volunteer\",\"cad_fiat_identity_verification_occupation_list_selected__label_waitress\":\"Waitress\",\"cad_fiat_identity_verification_occupation_list_selected__label_warehouse\":\"Warehouse\",\"cad_fiat_identity_verification_occupation_list_selected__label_warehouseworker\":\"Warehouse Worker\",\"cad_fiat_identity_verification_occupation_list_selected__placeholder_search\":\"Search\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_businessproceeds\":\"Business Proceeds\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_friendsandfamily\":\"Friends and Family\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_governmentbenefits\":\"Government Benefits\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_inheritance\":\"Inheritance\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_investmentproceeds\":\"Investment Proceeds\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_loan\":\"Loan\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_retirementincome\":\"Retirement Income\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_salary\":\"Salary\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_saleoftheproperty\":\"Sale of Property\",\"cad_fiat_identity_verification_source_of_funds_list_selected__label_savings\":\"Savings\",\"cad_fiat_occupation__label_please_select_your_occupation\":\"Occupation\",\"cad_fiat_occupation_list__button_done\":\"Done\",\"campaign_page__football_2026_hub__disclaimer__copy_0\":\"Terms and conditions apply. Subject to jurisdictional availability.\",\"campaign_page__football_2026_hub__display__cta_text\":\"View\",\"campaign_page__football_2026_hub__display__subtitle\":\"Trade on NFL and win up to ^[$500](color: 'danger') back on rewards. Participate now before its too late\",\"campaign_page__football_2026_hub__display__title\":\"NFL Campaigns\",\"campaign_page__football_2026_n1__campaign_rules__copy_0\":\"Every Monday, a new Yes or No question is posted. You get one free pick per week. Once submitted, it can't be changed.\",\"campaign_page__football_2026_n1__campaign_rules__copy_1\":\"Picks close every Sunday at 8:10 pm ET. If you pick correctly, you split the $10,000 weekly prize pool equally with all other winners as a 100% boost, capped between $1 and $50, depending on the number of winners that week.\",\"campaign_page__football_2026_n1__campaign_rules__copy_2\":\"Your boost is valid for 7 days and can be used on any market.\",\"campaign_page__football_2026_n1__campaign_rules__heading\":\"Campaign rules\",\"campaign_page__football_2026_n1__disclaimer__copy_0\":\"Campaign is subject to jurisdictional restrictions. Participants must read, understand and agree to the ^[Official Rules for the Sweepstakes](link:\\\"https://static.og.com/assets/documents/sweeptakes-us-over5k.pdf\\\") or the ^[Non-US Official Rules for the Sweepstakes](link:\\\"https://static.og.com/assets/documents/giveaway-non-us.pdf\\\") (as applicable), which apply to this Campaign. Participants are subject to the OG ^[Terms \u0026 Conditions](link:\\\"https://static.og.com/assets/documents/terms-and-conditions-us.pdf\\\") and ^[Terms of Use and Privacy Notice](link:\\\"https://og.com/privacy/usa\\\").\",\"campaign_page__football_2026_n1__rewards_distribution__copy_0\":\"Results are revealed every Monday. If you picked correctly, your boost is credited immediately and ready to use on your next trade.\",\"campaign_page__football_2026_n1__rewards_distribution__copy_1\":\"It expires 7 days after issuance at 23:59 ET.\",\"campaign_page__football_2026_n1__rewards_distribution__heading\":\"When are rewards distributed\",\"campaign_page__football_2026_n1__what_are_the_rewards__copy_0\":\"If you pick correctly, you split the $10,000 weekly prize pool equally with all other winners as a 100% boost, capped between $1 and $50, depending on the number of winners that week.\",\"campaign_page__football_2026_n1__what_are_the_rewards__copy_1\":\"A 100% boost amplifies your earnings when your prediction is correct. For example, if you apply a 100% boost coupon, up to $25. When your trade settles with a correct prediction, you earn up to $25 in additional earnings.\",\"campaign_page__football_2026_n1__what_are_the_rewards__copy_2\":\"Your boost is valid for 7 days and can be used on any market.\",\"campaign_page__football_2026_n1__what_are_the_rewards__heading\":\"What are the rewards\",\"campaign_page__football_2026_n1__who_can_participate__copy_0\":\"All KYC-approved users can participate for free.\",\"campaign_page__football_2026_n1__who_can_participate__copy_1\":\"No minimum balance or account tier required.\",\"campaign_page__football_2026_n1__who_can_participate__copy_2\":\"The campaign will run from September 7, 2026.\",\"campaign_page__football_2026_n1__who_can_participate__heading\":\"Who can participate\",\"campaign_page__football_2026_n2__campaign_rules__copy_0\":\"Place two single trades of $10 or more on any contract priced below $0.80 to complete your weekly mission. Your reward hits your account the moment your second trade settles.\",\"campaign_page__football_2026_n2__campaign_rules__copy_1\":\"Keep your streak going for bigger rewards each week. View the weekly rewards on the campaign page directly.\",\"campaign_page__football_2026_n2__campaign_rules__copy_2\":\"Hit your streak by Saturday 23:59 ET each week. Miss a week and your streak resets to Week 1 with a 0 week streak.\",\"campaign_page__football_2026_n2__campaign_rules__copy_3\":\"Week = Sunday 00:00 ET to Saturday 23:59 ET.\",\"campaign_page__football_2026_n2__campaign_rules__copy_4\":\"Coupon expiry: 7 days, expiring at 23:59 ET on the 7th day from issuance.\",\"campaign_page__football_2026_n2__campaign_rules__copy_5\":\"Coupons can be used in all markets.\",\"campaign_page__football_2026_n2__campaign_rules__heading\":\"Campaign rules\",\"campaign_page__football_2026_n2__disclaimer__copy_0\":\"Campaign is subject to jurisdictional restrictions. Participants must read, understand and agree to the ^[Official Rules for the Sweepstakes](link:\\\"https://static.og.com/assets/documents/sweeptakes-us-over5k.pdf\\\") or the ^[Non-US Official Rules for the Sweepstakes](link:\\\"https://static.og.com/assets/documents/giveaway-non-us.pdf\\\") (as applicable), which apply to this Campaign. Participants are subject to the OG ^[Terms \u0026 Conditions](link:\\\"https://static.og.com/assets/documents/terms-and-conditions-us.pdf\\\") and ^[Terms of Use and Privacy Notice](link:\\\"https://og.com/privacy/usa\\\").\",\"campaign_page__football_2026_n2__rewards_distribution__copy_0\":\"Rewards are credited the moment your second qualifying trade settles each week. Boosts are valid for 7 days from issuance and can be used on any market.\",\"campaign_page__football_2026_n2__rewards_distribution__copy_2\":\"1-week streak: 50% boost capped at $10.\",\"campaign_page__football_2026_n2__rewards_distribution__copy_3\":\"2-week streak: 50% boost capped at $20.\",\"campaign_page__football_2026_n2__rewards_distribution__copy_4\":\"3-week streak and beyond: $10 bonus (US/INTL) or rebate (NY).\",\"campaign_page__football_2026_n2__rewards_distribution__heading\":\"When are rewards distributed\",\"campaign_page__football_2026_n2__who_can_participate__copy_0\":\"All KYC-approved users can participate. No minimum balance or account tier required. The campaign will run from September 6, 2026 00:00 ET till further notice.\",\"campaign_page__football_2026_n2__who_can_participate__heading\":\"Who can participate\",\"campaign_page__pro_basketball_2026_hub__display__cta_text\":\"View\",\"campaign_page__pro_basketball_2026_hub__display__subtitle\":\"Explore available campaigns to win up to ^[$5,000](color: 'success_border') in cash prizes! Terms and conditions apply.\",\"campaign_page__pro_basketball_2026_hub__display__title\":\"Basketball Campaigns\",\"campaign_page__pro_basketball_b1_r1__campaign_rules__copy_0\":\"Join the Tipoff Campaign and trade Pro Basketball prediction markets. If you make it to the top-100 Leaderboard ranked by trading volume, you win a cash prize.\",\"campaign_page__pro_basketball_b1_r1__campaign_rules__copy_1\":\"Campaign Period: October 20, 2026, 12:00 am ET – October 26, 2026, 11:59 pm ET\",\"campaign_page__pro_basketball_b1_r1__campaign_rules__copy_2\":\"Place trades on any Pro Basketball prediction market priced below $0.80, combos included, to increase trading volume. Trades do not need to settle.\",\"campaign_page__pro_basketball_b1_r1__campaign_rules__heading\":\"Campaign Rules\",\"campaign_page__pro_basketball_b1_r1__disclaimer__copy_0\":\"The campaign is subject to jurisdictional restrictions. Participants must read, understand, and agree to the ^[Official Rules for the Sweepstakes](link:\\\"https://static.og.com/assets/documents/sweeptakes-us-over5k.pdf\\\") or the ^[Non-US Official Rules for the Sweepstakes](link:\\\"https://static.og.com/assets/documents/giveaway-non-us.pdf\\\") (as applicable), which apply to this campaign.\",\"campaign_page__pro_basketball_b1_r1__disclaimer__copy_1\":\"Participants are subject to the OG ^[Terms \u0026 Conditions](link:\\\"https://static.og.com/assets/documents/terms-and-conditions-us.pdf\\\") and ^[Terms of Use and Privacy Notice](link:\\\"https://og.com/privacy/usa\\\").\",\"campaign_page__pro_basketball_b1_r1__eligible_volume__copy_0\":\"Open and close volume on any basketball-linked prediction market on OG.com\",\"campaign_page__pro_basketball_b1_r1__eligible_volume__copy_1\":\"Combo contracts count if at least one leg is a basketball market\",\"campaign_page__pro_basketball_b1_r1__eligible_volume__copy_2\":\"Open and close any contract priced below $0.80\",\"campaign_page__pro_basketball_b1_r1__eligible_volume__copy_3\":\"Trades linked to a coupon are excluded\",\"campaign_page__pro_basketball_b1_r1__eligible_volume__heading\":\"What counts as eligible trading volume\",\"campaign_page__pro_basketball_b1_r1__rewards_distribution__copy_0\":\"Cash prizes will be awarded within 14 business days from the end of the campaign, by November 10, 2026.\",\"campaign_page__pro_basketball_b1_r1__rewards_distribution__heading\":\"When are prizes distributed\",\"campaign_page__pro_basketball_b1_r1__what_are_the_rewards__copy_0\":\"The cash prize pool starts at $5,000. If the total basketball trading volume surpasses $500,000, the pool becomes 1% of that trading volume.\",\"campaign_page__pro_basketball_b1_r1__what_are_the_rewards__copy_1\":\"Each winner's prize is their rank share of the pool (a fixed percentage based on rank), multiplied by the total prize pool. The 100 winners are ranked by their Pro Basketball contract trading volume. A higher volume means a higher rank and a larger cash prize.\",\"campaign_page__pro_basketball_b1_r1__what_are_the_rewards__heading\":\"What are the rewards\",\"campaign_page__pro_basketball_b1_r1__who_can_participate__copy_0\":\"All users who have completed account verification can participate for free.\",\"campaign_page__pro_basketball_b1_r1__who_can_participate__heading\":\"Who can participate\",\"campaign_progress__churned__prog_nav_title\":\"Comeback Campaign\",\"campaign_progress__churned__prog_rule_0\":\"Exclusively for returning OGs\",\"campaign_progress__churned__subtitle\":\"Exclusive to eligible and returning ^[OG.com](link:\\\"https://og.com\\\") users, terms and conditions apply\",\"campaign_progress__comeback_giveaway__extra_rule_0\":\"Settle a single trade of $10 or more within 7 days to earn your $5 reward.\",\"campaign_progress__comeback_giveaway__extra_title\":\"Trade ^[$10](color: 'active') and get ^[$5](color: 'success')!\",\"campaign_progress__comeback_giveaway__label\":\"Comeback Giveaway\",\"campaign_progress__comeback_giveaway__milestone_0\":\"Trade \u0026 Settle 1 time (min. $10) ^[$5 reward](color: 'success')\",\"campaign_progress__comeback_giveaway__prog_card_body\":\"Earn $5 once your trade settles\",\"campaign_progress__comeback_giveaway__prog_rule_0\":\"Place and settle a single trade of $10 or more to earn $5\",\"campaign_progress__comeback_giveaway__prog_rule_1\":\"Trades using other promos don't count toward the $10\",\"campaign_progress__comeback_giveaway__prog_rule_2\":\"Only contracts priced at $0.80 or lower are eligible\",\"campaign_progress__comeback_giveaway__prog_subheading\":\"Trade $10, Get ^[$5](color: 'success')\",\"campaign_progress__comeback_giveaway__tracker_rewards_title\":\"My rewards\",\"campaign_progress__football_2026_n2__extra_rule_0\":\"Settle 2 single trades of $10 or more every week to build your streak.\",\"campaign_progress__football_2026_n2__extra_rule_1\":\"Consecutive weeks unlock bigger rewards — 50% boost capped at $10 (week 1), $20 (week 2), then $10 bonus/rebate (week 3+).\",\"campaign_progress__football_2026_n2__extra_rule_2\":\"Miss a week? Your streak resets to week 1. Restart as many times as you want during the season.\",\"campaign_progress__football_2026_n2__extra_rule_3\":\"Trades using other promos don't count toward the $10.\",\"campaign_progress__football_2026_n2__extra_rule_4\":\"Only contracts priced lower than $0.80 are eligible.\",\"campaign_progress__football_2026_n2__extra_title\":\"Trade ^[2×$10](color: 'active') every week for ^[bigger rewards](color: 'success')!\",\"campaign_progress__football_2026_n2__prog_nav_title\":\"Weekly Trading Streak\",\"campaign_progress__football_2026_n2__prog_rule_0\":\"Settle 2 single trades of $10 or more every week\",\"campaign_progress__football_2026_n2__prog_rule_1\":\"Consecutive weeks unlock bigger rewards\",\"campaign_progress__football_2026_n2__prog_rule_2\":\"Miss a week and your streak resets — restart anytime\",\"campaign_progress__football_2026_n2__prog_rule_3\":\"Trades using other promos don't count\",\"campaign_progress__football_2026_n2__prog_rule_4\":\"Only contracts priced lower than $0.80 are eligible\",\"campaign_progress__football_2026_n2__prog_subheading\":\"Trade 2×$10, get ^[bigger rewards](color: 'success')\",\"campaign_progress__football_2026_n2__prog_title\":\"Weekly Trading Streak\",\"campaign_progress__football_2026_n2__subtitle\":\"Trade 2×$10 every week. Longer streaks, bigger rewards.\",\"campaign_progress__football_2026_n2__title\":\"Weekly Streak\",\"campaign_progress__football_2026_n2__tracker_rewards_subtitle\":\"Your reward is unlocked after 2 qualifying trades are settled\",\"campaign_progress__og_raf__cta_text\":\"Refer\",\"campaign_progress__og_raf__prog_nav_title\":\"Refer A Friend\",\"campaign_progress__og_raf__subtitle\":\"Both you and your friend get {0} each for successful referrals\",\"campaign_progress__og_raf__title\":\"Refer and Get\",\"campaign_progress__promo_d1f__extra_rule_0__25\":\"For new OGs who sign up using the promo code 'D1F' only\",\"campaign_progress__promo_d1f__extra_rule_1__25\":\"Trade and settle within 7 days from KYC approval to earn a reward\",\"campaign_progress__promo_d1f__extra_rule_2__25\":\"Place and settle a single trade of $25 or more to earn $25\",\"campaign_progress__promo_d1f__extr