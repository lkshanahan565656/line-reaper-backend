n_forgot_passcode\":\"Forgot Passcode?\",\"web_auth__code_modal_description\":\"Enter your referral or promo code to get up to \u003cgreen\u003e{amount}\u003c/green\u003e\",\"web_auth__description_access_restricted\":\"We are sorry, but OG.com services are currently not available in your region or your account has been restricted.\",\"web_auth__description_enter_code\":\"Enter your referral or promo code\",\"web_auth__description_google_auth\":\"Processing your Google authentication. Please wait.\",\"web_auth__description_login\":\"Securely access your portfolio and start trading on the world's leading prediction market.\",\"web_auth__description_redirecting\":\"Please wait while we securely redirect you to your destination.\",\"web_auth__description_security_verification\":\"Complete your security verification to access your OG.com account.\",\"web_auth__description_signup\":\"Join OG.com today to trade on sports, politics, and economics events.\",\"web_auth__description_ssn_received_explanation\":\"Federal regulations require us to use your SSN to verify your identity and prevent fraud. Your full SSN has been securely received from Verified and the last 4 digits are pre-filled for your review. This encrypted check is strictly for security and has no impact on your credit score.\",\"web_auth__description_ssn_required_explanation\":\"Federal regulations require us to use your SSN to verify your identity and prevent fraud. This encrypted check is strictly for security and has no impact on your credit score.\",\"web_auth__description_verified_autofill\":\"Verified autofills your info from trusted sources so you don't have to enter it manually. It's fast, safe, and secure.\",\"web_auth__description_verify_email\":\"Enter the verification code sent to your email to complete your account setup.\",\"web_auth__error_invalid_dsa\":\"Invalid DSA. Please try again.\",\"web_auth__error_invalid_format\":\"Invalid format\",\"web_auth__error_login_failed\":\"Something went wrong.