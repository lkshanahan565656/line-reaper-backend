"Invalid language.\",\"web_onboarding_login__error_invalid_phone_message\":\"Invalid mobile number.\",\"web_onboarding_login__error_invalid_recaptcha_message\":\"Invalid reCAPTCHA.\",\"web_onboarding_login__error_invalid_turnstile_message\":\"Invalid Turnstile Captcha.\",\"web_onboarding_login__error_recaptcha_not_loaded_message\":\"Recaptcha has not been loaded\",\"web_onboarding_login__error_recaptcha_threshold_not_met_message\":\"reCAPTCHA verification failed. Please try using a different network or device.\",\"web_onboarding_pre_kyc_login_enter_otp__label_resend_code\":\"Resend code\",\"web_onboarding_quiz_result__your_score\":\"Your Score\",\"web_onboarding_singpass__label_alias_name\":\"Alias Name\",\"web_onboarding_singpass__label_country_of_birth\":\"Country of Birth\",\"web_onboarding_singpass__label_date_of_birth\":\"Date of Birth\",\"web_onboarding_singpass__label_email\":\"Email\",\"web_onboarding_singpass__label_nationality\":\"Nationality\",\"web_onboarding_singpass__label_nric_fin\":\"NRIC/FIN\",\"web_onboarding_singpass__label_pass_expiry_date\":\"Pass Expiry Date\",\"web_onboarding_singpass__label_pass_status\":\"Pass Status\",\"web_onboarding_singpass__label_pass_type\":\"Pass Type\",\"web_onboarding_singpass__label_phone\":\"Phone\",\"web_onboarding_singpass__label_principal_name\":\"Principal Name\",\"web_onboarding_singpass__label_registered_address\":\"Registered Address\",\"web_onboarding_singpass__label_residential_status\":\"Residential Status\",\"web_onboarding_singpass__label_sex\":\"Sex\",\"web_onboarding_troubleshooting__button_got_it\":\"Got it\",\"web_one_button_lock_account_locked__button_contact_cs\":\"Contact Customer Support\",\"web_order_confirmation__go_to_portfolio\":\"Go to Portfolio\",\"web_parlay__label_add_outcomes_hint\":\"Add at least 2 outcomes to build a combo\",\"web_parlay__label_event_categories\":\"Combo event categories\",\"web_parlay__label_no_events_available\":\"No events available\",\"web_parlay__label_same_game_parlay\":\"Same-Game Combo\",\"web_parlay__label_select_a_market\":\"Select a market\",\"web_parlay__label_sgp_include_markets\":\"You can now include these markets in your same-game combo:\",\"web_parlay__label_sgp_now_available\":\"Same-Game Combo is now available for\",\"web_parlay__label_these_markets\":\"these markets\",\"web_parlay__toast_sgp_unavailable_selection_replaced\":\"Same-game combos aren't available for this match — Selection replaced\",\"web_passcode_reset_auth_flow_failure_prompt__title_something_went_wrong\":\"Something went wrong\",\"web_passcode_reset_auth_flow_retry_prompt__button_try_again\":\"Try again\",\"web_payment_add_cards__notification\":\"Your card {0} has been added\",\"web_payment_method__banner_cdc_methods_available\":\"Your Crypto.com payment methods are shared with OG.com.\",\"web_perps__btn_down\":\"Down\",\"web_perps__btn_up\":\"Up\",\"web_perps__button_price_down\":\"Price down\",\"web_perps__button_price_up\":\"Price up\",\"web_perps__button_view_position\":\"View position\",\"web_perps__desc_introducing_no_waiver\":\"Trade rising and falling prices on crypto. Up to 5x leverage.\",\"web_perps__description_not_eligible\":\"Contact us for more information.\",\"web_perps__info_intro_body\":\"A perpetual future is a contract that tracks the price of an underlying asset, such as cryptocurrency. You do not own the underlying asset. Instead, you trade the direction of its price:\\n\\n • Price up: You gain if the price rises and lose if it falls\\n • Price down: You gain if the price falls and lose if it rises\\n\\nThe position stays open until you close it, or until it is closed for you because your margin has been used.\",\"web_perps__info_intro_title\":\"What are perps?\",\"web_perps__info_offer_1_body\":\"Capitalize on both rising and falling prices.\",\"web_perps__info_offer_1_title\":\"Profit potential in any market\",\"web_perps__info_offer_2_body\":\"Open larger positions with less capital.\",\"web_perps__info_offer_2_title\":\"Up to 5x leverage\",\"web_perps__info_offer_3_body\":\"Set take-profit and stop-loss to manage risk.\",\"web_perps__info_offer_3_title\":\"Set your exit points\",\"web_perps__info_section_title\":\"Why trade Perps?\",\"web_perps__info_title\":\"Perps\",\"web_perps__label_about\":\"About\",\"web_perps__label_frequently_asked_questions\":\"Frequently Asked Questions\",\"web_perps__label_history_title_close\":\"Close\",\"web_perps__label_history_title_dividend_paid\":\"Dividend paid\",\"web_perps__label_history_title_dividend_received\":\"Dividend received\",\"web_perps__label_history_title_funding_paid\":\"Funding fee paid\",\"web_perps__label_history_title_funding_received\":\"Funding fee received\",\"web_perps__label_history_title_limit_buy_direction\":\"Limit buy ({direction})\",\"web_perps__label_history_title_liquidation\":\"Liquidation\",\"web_perps__label_history_title_margin_added\":\"Margin added\",\"web_perps__label_history_title_market_buy_direction\":\"Market buy ({direction})\",\"web_perps__label_history_title_position_opened\":\"Position opened ({direction})\",\"web_perps__label_history_title_stop_loss\":\"Stop Loss\",\"web_perps__label_history_title_take_profit\":\"Take Profit\",\"web_perps__label_market_data\":\"Market data\",\"web_perps__label_more_crypto_perps_coming\":\"More crypto perps coming soon\",\"web_perps__label_more_like\":\"More like {name} perps\",\"web_perps__label_pnl_abbr\":\"P\u0026L\",\"web_perps__label_powered_by\":\"Powered by\",\"web_perps__label_reconnecting\":\"Reconnecting to live data…\",\"web_perps__label_total_balance\":\"Total balance\",\"web_perps__label_transactions\":\"Transactions\",\"web_perps__label_your_positions\":\"Your positions\",\"web_perps__manage_dialog_cancel_desc\":\"If you cancel while the upcoming purchase is in progress, the upcoming purchase will still be executed. Other future purchases will be cancelled.\",\"web_perps__manage_dialog_cancel_title\":\"Confirm cancellation\",\"web_perps__market_field_24h_change\":\"24H change\",\"web_perps__market_field_24h_volume\":\"24H volume\",\"web_perps__market_field_funding_rate\":\"Funding rate\",\"web_perps__market_field_funding_rate_body\":\"A small payment between longs and shorts for Perpetuals, typically made every 8 hours.\\n\\nIt keeps the contract price aligned with the spot price.\\n\\nWhen the contract trades above spot, longs pay shorts, and vice versa.\\n\\nThis is paid between traders, not to the platform.\",\"web_perps__market_field_index_price\":\"Index price\",\"web_perps__market_field_index_price_body\":\"The current spot price of the underlying asset.\\n\\nIt's averaged across major exchanges, and the mark price tracks it.\\n\\nWhen the mark price and index price drift apart, the funding rate realigns them.\",\"web_perps__market_field_mark_price\":\"Mark price\",\"web_perps__market_field_mark_price_body\":\"The estimated fair value of your contract.\\n\\nIt determines your profit or loss and liquidation level.\\n\\nIt uses an average rather than a single price, so brief spikes don't affect your trade unfairly.\",\"web_perps__market_field_max_leverage\":\"Max. leverage\",\"web_perps__market_field_next_funding\":\"Next funding\",\"web_perps__market_field_open_interest\":\"Open interest\",\"web_perps__market_field_open_interest_body\":\"The total number of open contracts in a market.\\n\\nIt increases as new positions open and decreases as they close.\\n\\nHigher open interest generally means more liquidity.\",\"web_perps__metadata_description\":\"Trade perpetual futures contracts with leverage on OG. Access crypto and sports perpetuals with real-time pricing.\",\"web_perps__metadata_title\":\"Perpetual Futures Trading | OG\",\"web_perps__onboarding_body_activate_trading\":\"Answer a few verification questions to activate Perps trading.\",\"web_perps__onboarding_body_zero_fees_30_days\":\"Answer a few verification questions to activate Perps trading. Fees waived for 30 days.\",\"web_perps__onboarding_title_trade_crypto_perps\":\"Trade crypto perps up to 5x leverage\",\"web_perps__onboarding_title_zero_fees_30_days\":\"Zero-fee Perps trading for 30 days\",\"web_perps__row_max\":\"Max\",\"web_perps__stat_chart_funding\":\"Funding {rate}\",\"web_perps__stat_chart_volume\":\"{value} vol\",\"web_perps__stat_funding_rate\":\"Funding {rate}\",\"web_perps__stat_volume\":\"{value} vol (24h)\",\"web_perps__tab_overview\":\"Overview\",\"web_perps__tab_positions\":\"Positions\",\"web_perps__tab_transactions\":\"Transactions\",\"web_perps__title_not_eligible\":\"You're not eligible\",\"web_perps__title_perpetuals\":\"Perps\",\"web_perps__title_position_details\":\"Position details\",\"web_perps_position__button_add_margin\":\"Add margin\",\"web_perps_position__button_adjust_tp_sl\":\"Modify TPSL\",\"web_perps_position__button_close\":\"Close\",\"web_perps_position__button_close_position\":\"Close position\",\"web_perps_position__button_confirm\":\"Confirm\",\"web_perps_position__button_continue\":\"Continue\",\"web_perps_position__button_go_back\":\"Go back\",\"web_perps_position__button_got_it\":\"Got it\",\"web_perps_position__button_place_another_order\":\"Place another order\",\"web_perps_position__button_try_again\":\"Try again\",\"web_perps_position__close_position_confirm_heading\":\"This cannot be undone.\",\"web_perps_position__close_position_failed_subtitle\":\"Please try again\",\"web_perps_position__close_position_failed_title\":\"Position could not be closed\",\"web_perps_position__close_position_success_title\":\"Close order submitted\",\"web_perps_position__label_caution\":\"Cautious\",\"web_perps_position__label_column_action\":\"Action\",\"web_perps_position__label_column_asset\":\"Asset\",\"web_perps_position__label_column_date\":\"Date\",\"web_perps_position__label_column_margin_balance\":\"Margin balance\",\"web_perps_position__label_column_market\":\"Market\",\"web_perps_position__label_column_price\":\"Price\",\"web_perps_position__label_column_quantity\":\"Quantity\",\"web_perps_position__label_column_status\":\"Status\",\"web_perps_position__label_column_total_cost\":\"Total cost\",\"web_perps_position__label_column_unrealized_pnl\":\"Profit \u0026 Loss\",\"web_perps_position__label_dangerous\":\"Dangerous\",\"web_perps_position__label_est_trading_fee\":\"Est. trading fee\",\"web_perps_position__label_healthy\":\"Healthy\",\"web_perps_position__label_liquidation_at\":\"Liquidation at {price}\",\"web_perps_position__label_liquidation_price\":\"Liquidation price\",\"web_perps_position__label_liquidation_risk\":\"Liquidation risk\",\"web_perps_position__label_liquidation_risk_message\":\"Add margin or close your position to reduce risk.\",\"web_perps_position__label_liquidation_risk_warning\":\"Position nearing liquidation\",\"web_perps_position__label_margin_addition\":\"Margin addition\",\"web_perps_position__label_margin_health\":\"Margin health: \u003cband\u003e{status}\u003c/band\u003e\",\"web_perps_position__label_method\":\"Method\",\"web_perps_position__label_order_value\":\"Order value\",\"web_perps_position__label_position_nearing_liquidation\":\"Position nearing liquidation\",\"web_perps_position__label_realized_pnl\":\"Realized P\u0026L\",\"web_perps_position__label_reduce_liquidation_risk\":\"Add margin or close your position to reduce risk\",\"web_perps_position__label_status_filled_percent\":\"Filled {percent}%\",\"web_perps_position__label_total_pnl\":\"Total P\u0026L\",\"web_perps_position__label_total_size\":\"Total size\",\"web_perps_position__label_tp_sl\":\"TP/SL\",\"web_perps_position__label_tp_sl_entire_position_notice\":\"You're updating the take-profit/stop-loss of your entire position\",\"web_perps_position__label_tp_sl_pending_order_notice\":\"You have a pending order with take-profit \u0026 stop-loss. Saving here updates TP/SL on your current position now, and replaces any TP/SL set with that order.\",\"web_perps_position__label_trading_fee\":\"Trading fee\",\"web_perps_position__label_trading_fee_free\":\"FREE\",\"web_perps_position__label_unrealized_pnl\":\"Unrealized P\u0026L\",\"web_perps_position__pnl_modal_description\":\"The sum of your unrealized and realized P\u0026L for this position.\",\"web_perps_position__pnl_realized_description_detail\":\"Your position is marked to the current market price at each settlement cycle that happens two times per business day. The gain or loss since the last mark will be credited to or debited from your margin balance.\",\"web_perps_position__pnl_realized_description_short\":\"Profit or loss already settled to your margin balance.\",\"web_perps_position__pnl_unrealized_description\":\"Your position's value at market price before settlement.\",\"web_perps_position__result_margin_added\":\"{amount} margin added\",\"web_perps_position__title_confirm_margin_addition\":\"Confirm margin addition\",\"web_perps_position__title_profit_and_loss\":\"Profit \u0026 Loss\",\"web_perps_position__title_tp_sl\":\"Take Profit \u0026 Stop loss\",\"web_perps_position__title_tpsl_modified_successfully\":\"TPSL modified successfully\",\"web_perps_position__tooltip_margin_balance\":\"The amount backing your current position, calculated by your collateral and any unrealized profit or loss. Each position holds its own margin.\\n\\nIt is not the same as position size, which is the full leveraged value.\\n\\nMargin balance increases when your trade is in profit or you add margin. It decreases when your trade is at a loss, or when fees and funding are charged.\",\"web_perps_position__tpsl_modify_failed_subtitle\":\"Please try again\",\"web_perps_position__tpsl_modify_failed_title\":\"TPSL could not be modified\",\"web_perps_stories__button_continue\":\"Continue\",\"web_perps_stories__desc_introducing\":\"Trade rising and falling prices on crypto. Up to 5x leverage. 0% fees for 30 days.\",\"web_perps_stories__desc_leverage\":\"5x leverage turns $50 into $250 of exposure. Start at $5.\",\"web_perps_stories__desc_profit\":\"Think a stock is rising? Go long. Think it's falling? Go short.\",\"web_perps_stories__desc_protection\":\"Set a stop-loss so you never lose more than you're comfortable with\",\"web_perps_stories__title_introducing\":\"Introducing Perps\",\"web_perps_stories__title_leverage\":\"Amplify trades by up to 5x\",\"web_perps_stories__title_profit\":\"Profit potential however prices move\",\"web_perps_stories__title_protection\":\"You decide your risk level\",\"web_perps_trade__badge_waived\":\"Waived\",\"web_perps_trade__button_adjust_tpsl\":\"Adjust TPSL\",\"web_perps_trade__button_cancel\":\"Cancel\",\"web_perps_trade__button_confirm\":\"Confirm\",\"web_perps_trade__button_confirming\":\"Confirming...\",\"web_perps_trade__button_contact_customer_support\":\"Contact customer support\",\"web_perps_trade__button_continue\":\"Continue\",\"web_perps_trade__button_enable_to_trade\":\"Enable to trade\",\"web_perps_trade__button_login_to_trade\":\"Login to Trade\",\"web_perps_trade__button_max\":\"Max\",\"web_perps_trade__button_not_now\":\"Not now\",\"web_perps_trade__button_reset\":\"Reset\",\"web_perps_trade__button_try_again\":\"Try again\",\"web_perps_trade__error_insufficient_balance\":\"Insufficient balance\",\"web_perps_trade__error_limit_price_above_max\":\"Limit price can't be above {price}\",\"web_perps_trade__error_limit_price_below_min\":\"Limit price can't be below {price}\",\"web_perps_trade__error_max_order_value\":\"Max. order value is {amount}\",\"web_perps_trade__error_max_position_value\":\"Max. position value {amount}\",\"web_perps_trade__error_min_margin_required\":\"Min. margin required {amount}\",\"web_perps_trade__error_sl_above_liquidation\":\"Stop-loss must be above the liquidation price.\",\"web_perps_trade__error_sl_below_liquidation\":\"Stop-loss must be below the liquidation price.\",\"web_perps_trade__error_sl_too_close_limit\":\"Stop-loss is too close to the limit price.\",\"web_perps_trade__error_sl_too_close_liquidation\":\"Stop-loss is too close to the liquidation price.\",\"web_perps_trade__error_sl_too_close_market\":\"Stop-loss is too close to the market price.\",\"web_perps_trade__error_sl_wrong_side_down_limit\":\"Stop-loss must be above the limit price.\",\"web_perps_trade__error_sl_wrong_side_down_market\":\"Stop-loss must be above the market price.\",\"web_perps_trade__error_sl_wrong_side_up_limit\":\"Stop-loss must be below the limit price.\",\"web_perps_trade__error_sl_wrong_side_up_market\":\"Stop-loss must be below the market price.\",\"web_perps_trade__error_tp_too_close_limit\":\"Take-profit is too close to the limit price.\",\"web_perps_trade__error_tp_too_close_market\":\"Take-profit is too close to the market price.\",\"web_perps_trade__error_tp_wrong_side_down_limit\":\"Take-profit must be below the limit price.\",\"web_perps_trade__error_tp_wrong_side_down_market\":\"Take-profit must be below the market price.\",\"web_perps_trade__error_tp_wrong_side_up_limit\":\"Take-profit must be above the limit price.\",\"web_perps_trade__error_tp_wrong_side_up_market\":\"Take-profit must be above the market price.\",\"web_perps_trade__label_amount_input\":\"Amount\",\"web_perps_trade__label_asset_perp\":\"{symbol} Perp\",\"web_perps_trade__label_available_balance\":\"{amount}\\navailable\",\"web_perps_trade__label_double_position_description\":\"Your current position requires additional margin before you can place a new order.\",\"web_perps_trade__label_double_position_title\":\"Add margin to continue\",\"web_perps_trade__label_down\":\"Down\",\"web_perps_trade__label_est_margin_required\":\"Est. margin required\",\"web_perps_trade__label_fees_waived_until\":\"Fees waived until {date}\",\"web_perps_trade__label_from_current_price\":\"from the current price\",\"web_perps_trade__label_generic_error_description\":\"Please contact us if the problem persists.\",\"web_perps_trade__label_generic_error_title\":\"Try again\",\"web_perps_trade__label_leverage\":\"Leverage\",\"web_perps_trade__label_leverage_input\":\"Lever